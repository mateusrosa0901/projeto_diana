# Copie este arquivo para .streamlit/secrets.toml e preencha.
# No Streamlit Community Cloud, cole o MESMO conteúdo em:
#   App > Settings > Secrets
# O secrets.toml real está no .gitignore e nunca deve ir para o GitHub.

# ---------------------------------------------------------------------------
# Conta de serviço do Google (conteúdo do JSON baixado no Google Cloud)
# ---------------------------------------------------------------------------
[google_service_account]
type = "service_account"
project_id = ""
private_key_id = ""
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "nome@projeto.iam.gserviceaccount.com"
client_id = ""
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = ""
universe_domain = "googleapis.com"

# Opcional: só é usado se alguma fonte abaixo usar "titulo" em vez de "sheet_id"
[google_drive]
FOLDER_ID = ""

# ---------------------------------------------------------------------------
# Planilhas de onde o app lê os dados
# ---------------------------------------------------------------------------
# sheet_id ........ o trecho da URL entre /d/ e /edit
#                   https://docs.google.com/spreadsheets/d/<ESTE_TRECHO>/edit
#   (ou) titulo ... nome do arquivo dentro da pasta FOLDER_ID
# aba ............. nome da aba; vazio = primeira aba
# linha_cabecalho . linha onde estão os nomes das colunas (padrão 1)
# col_* ........... nome da coluna na planilha (maiúsculas/acentos são ignorados)
# col_uf .......... pode ser sigla ("MG") ou nome ("Minas Gerais"). Se a UF vier
#                   junto da cidade ("Contagem - MG"), deixe col_uf vazio.
#
# IMPORTANTE: compartilhe cada planilha com o client_email acima como "Leitor".

[fontes]
ttl_minutos = 10   # de quanto em quanto tempo o app relê as planilhas

[fontes.alunos]
sheet_id = ""
aba = ""
col_cidade = "Cidade"
col_uf = "UF"

[fontes.polos]
sheet_id = ""
aba = ""
col_cidade = "Cidade"
col_uf = "UF"
col_status = "Status"
col_bairro = "Bairro"

[fontes.localidades]
sheet_id = ""
aba = ""
col_cidade = "Cidade"
col_uf = "UF"
